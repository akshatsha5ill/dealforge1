{
  "openapi": "3.0.3",
  "info": {
    "title": "DealForge API",
    "description": "AI-powered meeting intelligence and sales CRM API",
    "version": "1.0.0"
  },
  "servers": [
    { "url": "/api", "description": "API server" }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Firebase JWT"
      },
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key",
        "description": "Read-only API key (generated in Settings → API Access). Available on Pro."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": { "type": "string" }
        }
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "string" },
          "uptime": { "type": "number" }
        }
      },
      "AnalysisResult": {
        "type": "object",
        "properties": {
          "status": { "type": "string" },
          "analysis": {
            "type": "object",
            "properties": {
              "summary": { "type": "string" },
              "actionItems": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "task": { "type": "string" },
                    "assignee": { "type": "string" }
                  }
                }
              },
              "sentiment": {
                "type": "object",
                "properties": {
                  "overall": { "type": "string", "enum": ["positive", "negative", "neutral"] },
                  "score": { "type": "integer" },
                  "notes": { "type": "string" }
                }
              }
            }
          }
        }
      },
      "EmailDraft": {
        "type": "object",
        "properties": {
          "status": { "type": "string" },
          "draft": {
            "type": "object",
            "properties": {
              "subject": { "type": "string" },
              "body": { "type": "string" }
            }
          }
        }
      },
      "TrackingEvent": {
        "type": "object",
        "properties": {
          "campaignId": { "type": "string" },
          "event": { "type": "string", "enum": ["open", "click"] },
          "url": { "type": "string" },
          "timestamp": { "type": "string", "format": "date-time" }
        }
      },
      "BufferData": {
        "type": "object",
        "properties": {
          "transcript": { "type": "object", "nullable": true },
          "notes": { "type": "object", "nullable": true },
          "meeting": { "type": "object", "nullable": true }
        }
      },
      "LeadScore": {
        "type": "object",
        "properties": {
          "score": { "type": "integer", "minimum": 0, "maximum": 100 },
          "reasoning": { "type": "string" },
          "category": { "type": "string", "enum": ["hot", "warm", "cold"] }
        }
      },
      "EmailSendResponse": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "from": { "type": "string" },
          "to": { "type": "string" }
        }
      },
      "ApiKeyNew": {
        "type": "object",
        "properties": {
          "status": { "type": "string" },
          "key": { "type": "string", "description": "Full API key. Shown only once — store it securely." },
          "keyHash": { "type": "string" },
          "name": { "type": "string" },
          "prefix": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "ApiKeySummary": {
        "type": "object",
        "properties": {
          "keyHash": { "type": "string" },
          "name": { "type": "string" },
          "prefix": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" },
          "lastUsedAt": { "type": "string", "format": "date-time", "nullable": true },
          "revoked": { "type": "boolean" }
        }
      },
      "SyncPayload": {
        "type": "object",
        "properties": {
          "meetings": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id"],
              "properties": {
                "id": { "type": "string" },
                "title": { "type": "string" },
                "startTime": { "type": "string" },
                "endTime": { "type": "string" },
                "duration": { "type": "number" },
                "status": { "type": "string" }
              }
            }
          },
          "analyses": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "meetingId"],
              "properties": {
                "id": { "type": "string" },
                "meetingId": { "type": "string" },
                "summary": { "type": "string" },
                "actionItems": { "type": "array", "items": { "type": "string" } },
                "leadScore": { "type": "number" },
                "modelUsed": { "type": "string" },
                "analyzedAt": { "type": "string" }
              }
            }
          },
          "leads": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id"],
              "properties": {
                "id": { "type": "string" },
                "meetingId": { "type": "string" },
                "name": { "type": "string" },
                "email": { "type": "string" },
                "company": { "type": "string" },
                "role": { "type": "string" },
                "score": { "type": "number" },
                "stage": { "type": "string" },
                "createdAt": { "type": "string" },
                "updatedAt": { "type": "string" }
              }
            }
          },
          "deals": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id"],
              "properties": {
                "id": { "type": "string" },
                "leadId": { "type": "string" },
                "title": { "type": "string" },
                "stage": { "type": "string" },
                "value": { "type": "number" },
                "probability": { "type": "number" },
                "expectedClose": { "type": "string" },
                "createdAt": { "type": "string" },
                "updatedAt": { "type": "string" }
              }
            }
          }
        }
      },
      "MeetingWithAnalysis": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "startTime": { "type": "string" },
          "endTime": { "type": "string" },
          "duration": { "type": "number" },
          "status": { "type": "string" },
          "summary": { "type": "string", "nullable": true },
          "actionItems": { "type": "array", "items": { "type": "string" } },
          "leadScore": { "type": "number", "nullable": true },
          "modelUsed": { "type": "string", "nullable": true },
          "analyzedAt": { "type": "string", "nullable": true }
        }
      }
    }
  },
  "paths": {
    "/": {
      "get": {
        "summary": "API status",
        "responses": {
          "200": {
            "description": "API is running",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string" },
                    "version": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health check",
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/HealthResponse" } }
            }
          }
        }
      }
    },
    "/auth/health": {
      "get": {
        "summary": "Auth service health check",
        "responses": {
          "200": { "description": "Auth service healthy" }
        }
      }
    },
    "/auth/dev-token": {
      "post": {
        "summary": "Get dev-only auth token (disabled in production)",
        "responses": {
          "200": { "description": "Dev mode response" },
          "404": { "description": "Not available in production" }
        }
      }
    },
    "/zoom/oauth/start": {
      "post": {
        "summary": "Start Zoom OAuth flow",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "description": "Authorization URL issued" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/zoom/oauth/callback": {
      "get": {
        "summary": "Zoom OAuth callback",
        "parameters": [
          {
            "name": "code",
            "in": "query",
            "required": true,
            "schema": { "type": "string" },
            "description": "Authorization code from Zoom"
          }
        ],
        "responses": {
          "200": { "description": "Token exchange successful" },
          "400": { "description": "Missing authorization code" },
          "500": { "description": "Token exchange failed" }
        }
      }
    },
    "/zoom/webhook": {
      "post": {
        "summary": "Zoom webhook handler",
        "description": "Receives Zoom meeting events (started, ended) and URL validation",
        "responses": {
          "200": { "description": "Webhook processed" },
          "401": { "description": "Invalid signature" },
          "500": { "description": "Server configuration error" }
        }
      }
    },
    "/zoom/deauth": {
      "post": {
        "summary": "Zoom deauthorization webhook",
        "description": "Receives Zoom deauth events and cleans up user Zoom tokens",
        "responses": {
          "200": { "description": "Deauth processed" },
          "401": { "description": "Invalid signature" },
          "500": { "description": "Server configuration error" }
        }
      }
    },
    "/zoom/transcription": {
      "post": {
        "summary": "Store transcription segment",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["meetingId", "segment"],
                "properties": {
                  "meetingId": { "type": "string" },
                  "segment": { "type": "object" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Segment stored and broadcast" },
          "400": { "description": "Missing required fields" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/zoom/notes": {
      "post": {
        "summary": "Store quick notes from Zoom panel",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["meetingId", "note"],
                "properties": {
                  "meetingId": { "type": "string" },
                  "note": { "type": "object" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Note stored" },
          "400": { "description": "Missing required fields" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/zoom/buffer/{meetingId}": {
      "get": {
        "summary": "Pull buffered meeting data",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "meetingId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Buffered data",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/BufferData" } }
            }
          },
          "401": { "description": "Unauthorized" }
        }
      },
      "delete": {
        "summary": "Clear buffered meeting data",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "meetingId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Buffer cleared" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/ai/analyze": {
      "post": {
        "summary": "Analyze meeting transcript with AI",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["transcript", "meetingId"],
                "properties": {
                  "transcript": { "type": "string" },
                  "meetingId": { "type": "string" },
                  "apiKey": { "type": "string" },
                  "model": { "type": "string", "enum": ["openai", "anthropic", "gemini"] }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Analysis complete",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/AnalysisResult" } }
            }
          },
          "400": { "description": "Invalid input" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/ai/score": {
      "post": {
        "summary": "Score a lead from transcript",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["transcript", "leadContext"],
                "properties": {
                  "transcript": { "type": "string" },
                  "leadContext": {
                    "type": "object",
                    "properties": {
                      "name": { "type": "string" },
                      "company": { "type": "string" },
                      "role": { "type": "string" },
                      "stage": { "type": "string" }
                    }
                  },
                  "apiKey": { "type": "string" },
                  "model": { "type": "string", "enum": ["openai", "anthropic", "gemini"] }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Lead scored",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string" },
                    "score": { "$ref": "#/components/schemas/LeadScore" }
                  }
                }
              }
            }
          },
          "400": { "description": "Invalid input" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/email/send": {
      "post": {
        "summary": "Send email via Resend",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["to", "subject", "body"],
                "properties": {
                  "to": { "type": "string", "format": "email" },
                  "subject": { "type": "string" },
                  "body": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Email sent",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string" },
                    "data": { "$ref": "#/components/schemas/EmailSendResponse" }
                  }
                }
              }
            }
          },
          "400": { "description": "Invalid input" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/email/draft": {
      "post": {
        "summary": "Generate AI email draft",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["transcript"],
                "properties": {
                  "transcript": { "type": "string" },
                  "leadContext": {
                    "type": "object",
                    "properties": {
                      "name": { "type": "string" },
                      "role": { "type": "string" },
                      "company": { "type": "string" }
                    }
                  },
                  "apiKey": { "type": "string" },
                  "model": { "type": "string", "enum": ["openai", "anthropic", "gemini"] }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Draft generated",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/EmailDraft" } }
            }
          },
          "400": { "description": "Invalid input" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/email/oauth/start": {
      "post": {
        "summary": "Start Gmail/Outlook OAuth flow",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["provider"],
                "properties": {
                  "provider": { "type": "string", "enum": ["gmail", "outlook"] }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Authorization URL issued" },
          "400": { "description": "Invalid input" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/email/oauth/{provider}/callback": {
      "get": {
        "summary": "Email OAuth provider callback",
        "parameters": [
          {
            "name": "provider",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "enum": ["gmail", "outlook"] },
            "description": "Email provider"
          },
          {
            "name": "code",
            "in": "query",
            "schema": { "type": "string" },
            "description": "OAuth authorization code"
          },
          {
            "name": "state",
            "in": "query",
            "schema": { "type": "string" },
            "description": "OAuth state token"
          }
        ],
        "responses": {
          "302": { "description": "Redirect back to the app" },
          "400": { "description": "Invalid callback" }
        }
      }
    },
    "/tracking/open/{campaignId}": {
      "get": {
        "summary": "Email open tracking pixel",
        "parameters": [
          {
            "name": "campaignId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "uid",
            "in": "query",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "1x1 tracking pixel",
            "content": { "image/gif": {} }
          }
        }
      }
    },
    "/tracking/click/{campaignId}": {
      "get": {
        "summary": "Email click tracking redirect",
        "parameters": [
          {
            "name": "campaignId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "url",
            "in": "query",
            "schema": { "type": "string" }
          },
          {
            "name": "uid",
            "in": "query",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "302": { "description": "Redirect to target URL" }
        }
      }
    },
    "/tracking/events": {
      "get": {
        "summary": "Pull tracking events for authenticated user",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Tracking events",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string" },
                    "events": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/TrackingEvent" }
                    }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/tracking/events/{campaignId}": {
      "get": {
        "summary": "Get events for specific campaign",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "campaignId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Campaign tracking events",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string" },
                    "events": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/TrackingEvent" }
                    }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/billing/webhook": {
      "post": {
        "summary": "Dodo Payments webhook (HMAC-verified, no Firebase auth)",
        "description": "Public endpoint. Authenticity is verified inside the handler via the Dodo webhook signature over the raw body.",
        "responses": {
          "200": { "description": "Event processed (idempotent)" },
          "400": { "description": "Invalid signature or payload" }
        }
      }
    },
    "/email/webhooks/resend": {
      "post": {
        "summary": "Resend event webhook (Svix-verified)",
        "description": "Public endpoint. Svix signature is verified when RESEND_WEBHOOK_SECRET is set; verification is skipped outside production and fails closed in production.",
        "responses": {
          "200": { "description": "Event recorded" },
          "400": { "description": "Invalid signature or payload" }
        }
      }
    },
    "/zoomverify/verifyzoom.html": {
      "get": {
        "summary": "Zoom domain-verification token",
        "responses": {
          "200": { "description": "Verification token (or not-configured placeholder)" }
        }
      }
    },
    "/referrals/claim": {
      "post": {
        "summary": "Claim a referral code",
        "description": "Records that the authenticated user was referred by a code. Free users get +1 analyzed meeting/month for 3 months; paid users get 1 free month credit.",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["code"],
                "properties": {
                  "code": { "type": "string", "example": "DF-ABCD2345" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Claim result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string" },
                    "claimStatus": { "type": "string", "enum": ["claimed", "already_claimed", "self_referral", "invalid_code", "limit_reached"] },
                    "benefit": { "type": "string", "enum": ["meeting_bonus", "free_month"] },
                    "code": { "type": "string" }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/referrals/status": {
      "get": {
        "summary": "Get referral status",
        "description": "Returns the user's referral code, claimed codes, active benefits, and how many people used their code.",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Referral status",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string" },
                    "code": { "type": "string" },
                    "bonusMeetings": { "type": "integer" },
                    "freeMonthsCredit": { "type": "integer" },
                    "referralsMade": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "uid": { "type": "string" },
                          "claimedAt": { "type": "string" }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/api-keys": {
      "post": {
        "summary": "Create an API key",
        "description": "Creates a new read-only API key. The full key is returned only once.",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string", "description": "Optional label for the key" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Key created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiKeyNew" }
              }
            }
          },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Requires Pro plan" }
        }
      },
      "get": {
        "summary": "List API keys",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "List of API keys (full key never returned)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string" },
                    "keys": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/ApiKeySummary" }
                    }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/api-keys/{keyHash}": {
      "delete": {
        "summary": "Revoke an API key",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "keyHash",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Key revoked",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string" },
                    "revoked": { "type": "boolean" }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthorized" },
          "404": { "description": "Key not found" }
        }
      }
    },
    "/sync": {
      "post": {
        "summary": "Sync derived data (summaries, action items, lead scores — never transcripts)",
        "description": "Opt-in: pushes derived meeting intelligence from the local-first client to the server so the read-only API can serve it. Body is idempotent; each item is upserted by id.",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SyncPayload" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Synced",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string" }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Requires Pro plan" }
        }
      }
    },
