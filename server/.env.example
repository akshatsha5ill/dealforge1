# DealForge Server — copy to .env
# Required in production (server/src/config.ts exits 1 if missing):
# CLIENT_URL, ZOOM_CLIENT_ID, ZOOM_CLIENT_SECRET, ZOOM_WEBHOOK_SECRET_TOKEN,
# SESSION_SECRET, RESEND_API_KEY, FIREBASE_PROJECT_ID, FIREBASE_CLIENT_EMAIL, FIREBASE_PRIVATE_KEY

# --- Core ---
NODE_ENV=development
PORT=3000
# REQUIRED (prod): public URL of the client, used for CORS + OAuth defaults
CLIENT_URL=http://localhost:5173
# REQUIRED (prod): express-session signing secret — use a long random string
SESSION_SECRET=change-me-to-a-long-random-string

# --- Zoom OAuth / Webhooks (3 REQUIRED in prod) ---
ZOOM_CLIENT_ID=your-zoom-client-id
ZOOM_CLIENT_SECRET=your-zoom-client-secret
ZOOM_WEBHOOK_SECRET_TOKEN=your-zoom-webhook-secret-token
# Optional: defaults to ${CLIENT_URL}/api/zoom/oauth/callback
ZOOM_REDIRECT_URI=http://localhost:3000/api/zoom/oauth/callback
# Optional: Zoom Meeting SDK (client-side meeting join)
ZOOM_SDK_KEY=your-zoom-sdk-key
ZOOM_SDK_SECRET=your-zoom-sdk-secret
# Optional: Zoom URL verification token (GET /api/zoom/webhook verification)
ZOOM_VERIFY_TOKEN=your-zoom-verify-token

# --- Email (RESEND_API_KEY REQUIRED in prod) ---
RESEND_API_KEY=re_your-resend-api-key
EMAIL_FROM=DealForge <noreply@dealforge.app>
# Optional: Gmail / Microsoft OAuth for email sync
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
# Optional: defaults to ${CLIENT_URL}/api/email/oauth
OAUTH_REDIRECT_BASE=http://localhost:3000/api/email/oauth

# --- Firebase Admin SDK (all 3 REQUIRED in prod; private key must keep \n newlines) ---
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- AI (transcript-analysis-pipeline: first set key wins; models have defaults in config.ts) ---
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-3.1-pro

# --- Redis (optional: caching / queues; unset = in-memory fallback) ---
REDIS_URL=redis://localhost:6379

# --- Billing / Dodo Payments (optional until billing enabled) ---
DODO_PAYMENTS_API_KEY=your-dodo-api-key
DODO_PAYMENTS_WEBHOOK_KEY=your-dodo-webhook-key
DODO_PRO_PRODUCT_ID=prod_pro_xxx
DODO_ENTERPRISE_PRODUCT_ID=prod_ent_xxx

# --- Security / Observability (optional) ---
# Used by utils/crypto.ts as encryption secret (falls back to ZOOM_WEBHOOK_SECRET_TOKEN)
ENCRYPTION_KEY=change-me-to-a-32-byte-random-string
# Enables Sentry in app.ts when NODE_ENV=production
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
