# DealForge Client (Vite) — copy to .env
# Used by: src/services/firebase/config.ts, src/services/api/client.ts, src/hooks/useWebSocket.ts

# --- Backend URL (used by api/client.ts BASE_URL and useWebSocket.ts serverUrl) ---
# Unset = same-origin '/api' + window.location.origin for sockets (fine for local dev proxy).
# Set this in production to your Render backend URL.
VITE_API_URL=https://your-api.onrender.com

# --- Firebase Web SDK (all REQUIRED; missing VITE_FIREBASE_API_KEY runs in dummy-auth mode) ---
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abc123def456

# --- Observability / Analytics (optional) ---
# Enables Sentry in src/main.tsx when Vite PROD build
VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# Enables Google Analytics in src/services/analytics.ts
VITE_GA_ID=G-XXXXXXXXXX
